# Copy to `.env` for local overrides, or use `.env.development` with APP_ENV=development
# For VPS dev branch deployment (dev.<domain>), set:
# - CORS_ORIGINS=https://dev.<your-domain>
# - PUBLIC_FRONTEND_URL=https://dev.<your-domain>
# - FRONTEND_OAUTH_REDIRECT_URL=https://dev.<your-domain>/auth/callback
# - GOOGLE_OAUTH_REDIRECT_URI=https://dev.<your-domain>/api/auth/google/callback
APP_ENV=development

MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=pandore

JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256

# Stripe — https://dashboard.stripe.com/apikeys
# Secret key (sk_test_… / sk_live_…) : uniquement sur le serveur, jamais dans le front.
STRIPE_API_KEY=
# Webhook signing secret (whsec_…) : destination *snapshot* → POST /api/webhook/stripe
STRIPE_WEBHOOK_SECRET=
# Même principe pour la destination *thin* → POST /api/webhook/stripe/thin (secret différent)
STRIPE_WEBHOOK_SECRET_THIN=
# Devise des prix (unit_amount en centimes). ex. eur, usd
STRIPE_CURRENCY=eur
# Stripe Connect : commission plateforme sur chaque vente (pourcentage)
STRIPE_PLATFORM_FEE_PERCENT=5
# true = les artistes peuvent retirer via Connect Express. false = cagnotte sans retrait.
STRIPE_CONNECT_ENABLED=true
# URL du front pour les retours onboarding Connect (ex. http://localhost:3000)
PUBLIC_FRONTEND_URL=http://localhost:3000
# Seuil de retrait cagnotte → Stripe Connect (euros)
STRIPE_MIN_PAYOUT_EUROS=10

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
FRONTEND_OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Comma-separated origins, or * (dev only)
CORS_ORIGINS=http://localhost:3000

# Comma-separated emails that always receive admin access (survives role switches)
ADMIN_EMAILS=bastien.schektman@gmail.com,merwan.snk@gmail.com,merwane.snk@gmail.com

# Password reset email — OVH mailbox (preferred) or any SMTP.
# Host/user/from : ok à committer. SMTP_PASSWORD : VPS only, never push.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=no-reply@kloud-music.fr
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@kloud-music.fr
SMTP_FROM_NAME=Kloud
SMTP_REPLY_TO=support@kloud-music.fr
FRONTEND_RESET_PASSWORD_URL=https://kloud-music.fr/reset-password
