# Production template — prefer setting these in Railway dashboard (secrets).
# If you deploy this file, fill MONGO_URL and secrets; never commit real secrets.
APP_ENV=production
MONGO_URL="mongodb+srv://bastienschektman_db_user:Bast12007-@cluster0.nkpthxw.mongodb.net/?appName=Cluster0"
DB_NAME=pandore
JWT_SECRET=pandore_secret_key_change_in_production_2025
JWT_ALGORITHM=HS256
STRIPE_API_KEY=
# Webhook signing secret (whsec_…) : Dashboard → Developers → Webhooks → ton endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_XnEtOEalVOOrP2tskYPTaH7s3Qkrd1Fu
# Devise des prix (unit_amount en centimes). ex. eur, usd
STRIPE_CURRENCY=eur
# Même principe pour la destination *thin* → POST /api/webhook/stripe/thin (secret différent)
STRIPE_WEBHOOK_SECRET_THIN=whsec_11ir3b1b8uscorUuwpmcDVk4gVUkc98m
# Stripe Connect : commission plateforme sur chaque vente (pourcentage)
STRIPE_PLATFORM_FEE_PERCENT=5
# true = les artistes peuvent retirer via Connect Express. false = cagnotte sans retrait.
STRIPE_CONNECT_ENABLED=true
# URL du front pour les retours onboarding Connect (ex. http://localhost:3000)
PUBLIC_FRONTEND_URL=https://kloud-music.fr
# Seuil de retrait cagnotte → Stripe Connect (euros)
STRIPE_MIN_PAYOUT_EUROS=10
STRIPE_MIN_PAYOUT_HINT_EUROS=10
# Comma-separated emails that always receive admin access
ADMIN_EMAILS=bastien.schektman@gmail.com,merwan.snk@gmail.com,merwane.snk@gmail.com

# Password reset — OVH. Remplir SMTP_PASSWORD sur le VPS, ne pas push le mot de passe.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=no-reply@kloud-music.fr
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@kloud-music.fr
SMTP_FROM_NAME=Kloud
SMTP_REPLY_TO=support@kloud-music.fr
FRONTEND_RESET_PASSWORD_URL=https://kloud-music.fr/reset-password